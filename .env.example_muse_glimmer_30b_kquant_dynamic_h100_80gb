# Official Meta Muse Glimmer 30B K-Quant-Dynamic GGUF preset for one H100 80 GB.
# This preset connects llm-serve to a separately started llama-server process.
# Copy this file to .env after following docs/muse-glimmer-llamacpp.md.

# --- llm-serve network ---

# Interface for llm-serve. Permissible value: a bindable hostname or IP address.
HOST=127.0.0.1

# Port for the llm-serve OpenAI- and Ollama-compatible APIs.
# Permissible values: integers from 1 through 65535.
PORT=11424

# --- Backend and model ---

# Backend implementation. Permissible values: vllm, llamacpp, ollama, mock.
# Muse Glimmer's official quantization is GGUF, so this preset uses llamacpp.
INFERENCE_BACKEND=llamacpp

# Shared fallback model id. It must be present in MODEL_ALLOWLIST.
DEFAULT_MODEL_ID=meta-models/Muse-Glimmer-30B-GGUF

# llama-server model alias. This must exactly match the value passed to --alias.
# Leave empty only when DEFAULT_MODEL_ID already matches the llama-server alias.
LLAMACPP_DEFAULT_MODEL_ID=meta-models/Muse-Glimmer-30B-GGUF

# Comma-separated model aliases accepted by llm-serve.
MODEL_ALLOWLIST=meta-models/Muse-Glimmer-30B-GGUF

# Comma-separated subset allowed to receive reasoning_effort.
# Permissible request values for Muse: low, medium, high, xhigh.
REASONING_MODEL_ALLOWLIST=meta-models/Muse-Glimmer-30B-GGUF

# Repo-local model directory. Download commands in the Muse guide use this path.
MODEL_CACHE_DIR=models

# --- llama-server connection ---

# OpenAI-compatible llama-server base URL. Permissible value: an http(s) URL
# ending in /v1. llm-serve does not start or stop llama-server.
LLAMACPP_BASE_URL=http://127.0.0.1:8080/v1

# Optional bearer token matching llama-server --api-key. Leave empty for no auth.
LLAMACPP_API_KEY=

# --- Context and generation ---

# Muse's native context is 131,072+ tokens. Reserve 32K for reasoning and output.
# Permissible values: positive integers; input plus output should remain within
# the --ctx-size configured on llama-server.
MAX_INPUT_TOKENS=98304

# Maximum accepted generated tokens. Permissible values: positive integers.
MAX_OUTPUT_TOKENS=32768

# Meta's recommended Muse sampling defaults.
# Temperature is normally 0 through 2; top-p is greater than 0 through 1.
DEFAULT_TEMPERATURE=1.0
DEFAULT_TOP_P=0.95

# llama-server supplies top-k; start it with --top-k 64 as shown in the guide.

# --- Concurrency and queues ---

# Keep one active request to prioritize the complete 128K context. Permissible
# values: positive integers. Increase both this and llama-server --parallel only
# after measuring KV-cache memory and agent quality on the target workload.
PROMPT_MAX_PARALLEL=1
BATCH_MAX_PARALLEL=1

# Extra requests allowed to wait. Permissible values: non-negative integers.
FOREGROUND_QUEUE_LIMIT=32
BATCH_QUEUE_LIMIT=128

# --- Timeouts ---

# Maximum request duration or streaming gap in seconds. Must be greater than 0.
REQUEST_TIMEOUT_SECONDS=900

# Maximum model readiness/switch duration in seconds. Must be greater than 0.
SWITCH_TIMEOUT_SECONDS=120

# Auto-vLLM timeout is validated globally but unused by the llamacpp backend.
# Permissible value: any positive number.
VLLM_AUTOTUNE_TIMEOUT_SECONDS=7200

# --- Startup checks ---

# Verify the llama-server alias during llm-serve startup. Supported: true, false.
STARTUP_LOAD_DEFAULT_MODEL=true

# Avoid an unsolicited generation and concurrency profile during startup.
# Supported values: true, false.
STARTUP_SELF_TEST_ENABLED=false
STARTUP_SELF_TEST_BLOCKING=false
STARTUP_CONCURRENCY_TEST=false

# Retained for optional manual enabling. Output must not exceed MAX_OUTPUT_TOKENS;
# concurrency level must be an integer of at least 2.
STARTUP_SELF_TEST_PROMPT=Reply with one short sentence confirming readiness.
STARTUP_SELF_TEST_MAX_OUTPUT_TOKENS=64
STARTUP_CONCURRENCY_TEST_MAX_LEVEL=2

# --- Runtime storage ---

# Batch and upload state. Permissible value: a writable directory path.
STORAGE_ROOT=data/runtime

# Completed artifact retention in hours. Use 0 to disable cleanup.
# Permissible values: non-negative integers.
STORAGE_RETENTION_HOURS=720

# Mock-only delay. Permissible values: non-negative seconds.
MOCK_RESPONSE_DELAY_SECONDS=0.0
